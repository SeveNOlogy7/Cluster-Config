{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>trueforge-org/renovate-config"
  ],
  // 本仓库护栏 (2026-11-14, 激活 Renovate App 前预置; 2026-11-15 首跑后补 talconfig 缺口):
  packageRules: [
    {
      // tuppr plans + talconfig = Talos/k8s 版本与节点容器镜像: 自动合并会引发
      // 节点自动滚动重启, 风险高, 必须 dashboard 人工批准 (PR 仍会自动准备)
      description: "Talos/k8s upgrade plans and node images - manual approval only",
      matchPaths: [
        "clusters/main/kubernetes/system/system-upgrade/**",
        "clusters/main/talos/**",
      ],
      automerge: false,
      dependencyDashboardApproval: true,
    },
    {
      // flux 自身的 OCI manifest 版本: 控制面组件跨 minor 自更新风险大, 人工批准
      description: "flux self-update - manual approval only",
      matchPaths: ["repositories/oci/**", "clusters/main/kubernetes/flux-system/**"],
      automerge: false,
      dependencyDashboardApproval: true,
    },
    {
      // 这三个 chart 消费 home-ops-mirror, 该源 artifacts 已长期未更新
      // (2026-09-29 起), bump 后 flux 会拉不到 chart 导致 HR 卡死;
      // 迁源 (registry.k8s.io / upstream) 后删除本条
      description: "home-ops-mirror consumers - frozen until mirror re-routed",
      matchPaths: [
        "clusters/main/kubernetes/system/longhorn/app/helm-release.yaml",
        "clusters/main/kubernetes/kube-system/metrics-server/app/helm-release.yaml",
        "clusters/main/kubernetes/observability/headlamp/app/helm-release.yaml",
      ],
      enabled: false,
    },
  ],
}
